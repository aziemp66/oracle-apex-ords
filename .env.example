# --- Database & APEX Credentials ---
# The password for the Oracle Database (SYS/SYSTEM) and the APEX INTERNAL ADMIN account.
# Oracle requires at least 1 uppercase, 1 lowercase letter, and 1 number.
DB_PASSWORD=SuperSecurePassword123!

# --- Host Port Mapping ---
# The port on your host machine to access the Oracle Database
PORT_DB=1521

# The port on your host machine to access the APEX/ORDS Web UI
PORT_ORDS=8080
